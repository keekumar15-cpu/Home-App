# Postgres connection — points at the DB already running on your Hostinger VPS.
# If Postgres runs directly on the host (not in a container), use host.docker.internal.
DATABASE_URL="postgresql://rentapp_user:CHANGE_ME@host.docker.internal:5432/rentdb"

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME"

# Single admin login. Generate ADMIN_PASSWORD_HASH with:
#   npm run hash-password -- "your-password-here"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="CHANGE_ME"

# Day of month rent is due (1-31). Past this day, unpaid tenants show as overdue.
RENT_DUE_DAY=5

PORT=4000
NODE_ENV=production
