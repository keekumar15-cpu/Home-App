generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A tenant occupying a unit. Opening balance and advance are tracked here;
// rent amount and lease dates live on Contract so a tenant can have several
// contracts over time (renewals) without losing history.
model Tenant {
  id                  Int       @id @default(autoincrement())
  name                String
  unit                String?
  contact             String?
  currency            String    @default("INR") // INR | IDR | USD | SGD | EUR
  openingBalance      Decimal   @default(0) @db.Decimal(12, 2)
  advanceAmount       Decimal   @default(0) @db.Decimal(12, 2)
  advanceStatus       String    @default("held") // held | returned
  advanceReturnedDate DateTime?
  status              String    @default("active") // active | vacated
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contracts           Contract[]
  payments            Payment[]
  balanceAdjustments  BalanceAdjustment[]
}

// One lease term. Renewing a tenant means adding a new Contract row rather
// than editing the old one, so rent history and past terms are preserved.
model Contract {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  startDate   DateTime
  endDate     DateTime
  monthlyRent Decimal  @db.Decimal(12, 2)
  status      String   @default("active") // active | expired | renewed
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

// A record of money actually received from a tenant, tagged to the month
// it's meant to cover ("forMonth", e.g. "2026-09"). The dashboard compares
// this against the active contract's monthlyRent to compute what's still
// outstanding for the current month.
model Payment {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  forMonth    String // "YYYY-MM"
  paymentDate DateTime  @default(now())
  method      String? // cash | bank transfer | upi | cheque | other
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, forMonth])
}

// History of every opening-balance edit, so adjusting a balance down (as a
// tenant pays it off) never silently loses the "why" and "when".
model BalanceAdjustment {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  oldValue  Decimal  @db.Decimal(12, 2)
  newValue  Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// A recurring or one-time bill to track and pay (electricity, internet, etc).
model Bill {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  currency  String   @default("INR") // INR | IDR | USD | SGD | EUR
  amount    Decimal  @db.Decimal(12, 2) // expected amount
  frequency String   @default("monthly") // monthly | yearly | one-time
  dueDay    Int? // day of month/year bills are due, for recurring
  dueDate   DateTime? // for one-time bills
  status    String   @default("active") // active | closed
  notes     String?
  createdAt DateTime @default(now())

  payments BillPayment[]
}

model BillPayment {
  id        Int      @id @default(autoincrement())
  billId    Int
  bill      Bill     @relation(fields: [billId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  forPeriod String? // "YYYY-MM" for recurring bills, null for one-time
  paidDate  DateTime @default(now())
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([billId, forPeriod])
}

// Money lent to a friend/family member, tracked like a mini-loan ledger.
model Loan {
  id           Int      @id @default(autoincrement())
  borrowerName String
  contact      String?
  currency     String   @default("INR") // INR | IDR | USD | SGD | EUR
  principal    Decimal  @db.Decimal(12, 2)
  dateGiven    DateTime
  interestRate Decimal  @default(0) @db.Decimal(5, 2) // percent, 0 = interest-free
  status       String   @default("active") // active | closed
  notes        String?
  createdAt    DateTime @default(now())

  repayments LoanRepayment[]
}

model LoanRepayment {
  id       Int      @id @default(autoincrement())
  loanId   Int
  loan     Loan     @relation(fields: [loanId], references: [id])
  amount   Decimal  @db.Decimal(12, 2)
  date     DateTime @default(now())
  notes    String?
  createdAt DateTime @default(now())

  @@index([loanId])
}

// A simple log of major one-off expenses (not recurring bills).
model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  category    String?
  description String
  currency    String   @default("INR") // INR | IDR | USD | SGD | EUR
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([date])
}

// A reimbursable expense to claim back (from an employer, client, etc.),
// tracked until logged as claimed.
model Claim {
  id            Int       @id @default(autoincrement())
  description   String
  category      String?
  currency      String    @default("INR") // INR | IDR | USD | SGD | EUR
  amount        Decimal   @db.Decimal(12, 2)
  dateIncurred  DateTime  @default(now())
  status        String    @default("pending") // pending | claimed
  claimedDate   DateTime?
  claimedAmount Decimal?  @db.Decimal(12, 2) // may differ slightly from amount
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([status])
}

// A pending job/task with a target completion date and an optional earlier
// reminder date. No email/push notifications — the reminder is a dashboard
// flag, same convention as overdue rent/bills elsewhere in this app.
model Job {
  id           Int       @id @default(autoincrement())
  title        String
  category     String?
  targetDate   DateTime
  reminderDate DateTime?
  status       String    @default("pending") // pending | done
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([status])
}
