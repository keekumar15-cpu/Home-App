<%- include('../partials/header') %>

<h1><%= tenant ? 'Edit tenant' : 'Add tenant' %></h1>
<p><a href="/" class="muted">← Back to dashboard</a></p>

<div class="card" style="margin-top:20px; max-width:560px;">
  <form action="<%= tenant ? '/tenants/' + tenant.id : '/tenants' %>" method="POST">
    <label for="name">Tenant name</label>
    <input type="text" id="name" name="name" value="<%= tenant ? tenant.name : '' %>" required />

    <label for="unit">Unit / property</label>
    <input type="text" id="unit" name="unit" value="<%= tenant && tenant.unit ? tenant.unit : '' %>" />

    <label for="contact">Contact</label>
    <input type="text" id="contact" name="contact" value="<%= tenant && tenant.contact ? tenant.contact : '' %>" />

    <label for="currency">Currency</label>
    <select id="currency" name="currency">
      <% CURRENCY_CODES.forEach(c => { %>
        <option value="<%= c %>" <%= tenant && tenant.currency === c ? 'selected' : (!tenant && c === 'INR' ? 'selected' : '') %>><%= c %></option>
      <% }) %>
    </select>

    <% if (!tenant) { %>
      <label for="openingBalance">Opening balance</label>
      <input type="number" step="0.01" id="openingBalance" name="openingBalance" value="0" />

      <label for="advanceAmount">Advance amount held</label>
      <input type="number" step="0.01" id="advanceAmount" name="advanceAmount" value="0" />

      <h3 style="margin-top:24px;">Contract</h3>

      <label for="startDate">Contract start</label>
      <%- include('../partials/date-select', { name: 'startDate' }) %>

      <label for="endDate">Contract end</label>
      <%- include('../partials/date-select', { name: 'endDate' }) %>

      <label for="monthlyRent">Monthly rent</label>
      <input type="number" step="0.01" id="monthlyRent" name="monthlyRent" required />
    <% } %>

    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

    <button type="submit" class="btn"><%= tenant ? 'Save changes' : 'Add tenant' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
