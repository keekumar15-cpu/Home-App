<%- include('../partials/header') %>

<div class="topbar" style="padding:0; border:none; margin-bottom:8px;">
  <h1><%= tenant.name %></h1>
  <span class="badge <%= status.color %>">
    <% if (status.contractExpired) { %>Contract expired
    <% } else if (status.overdue) { %>Overdue
    <% } else if (status.outstanding > 0) { %>Partial
    <% } else { %>Paid up
    <% } %>
  </span>
</div>
<p class="muted" style="margin-top:0;"><%= tenant.unit || 'No unit set' %> <% if (tenant.contact) { %>· <%= tenant.contact %><% } %> · <%= tenant.currency %></p>
<p><a href="/tenants/<%= tenant.id %>/edit" class="muted">Edit tenant details</a> · <a href="/" class="muted">Back to dashboard</a></p>

<div class="two-col" style="margin-top:24px;">

  <div>
    <div class="card">
      <h3>This month</h3>
      <div class="row"><span class="k">Monthly rent</span><span class="v"><%= formatMoney(status.expected, tenant.currency) %></span></div>
      <div class="row"><span class="k">Received</span><span class="v"><%= formatMoney(status.receivedThisMonth, tenant.currency) %></span></div>
      <div class="row"><span class="k">Outstanding</span><span class="v"><%= formatMoney(status.outstanding, tenant.currency) %></span></div>
      <% if (status.contract) { %>
        <div class="row"><span class="k">Current contract</span><span class="v"><%= new Date(status.contract.startDate).toLocaleDateString('en-IN') %> – <%= new Date(status.contract.endDate).toLocaleDateString('en-IN') %></span></div>
      <% } %>
    </div>

    <div class="card">
      <h3>Log a payment</h3>
      <form action="/tenants/<%= tenant.id %>/payments" method="POST">
        <label for="amount">Amount (<%= tenant.currency %>)</label>
        <input type="number" step="0.01" id="amount" name="amount" required />

        <label for="forMonth">For month</label>
        <input type="month" id="forMonth" name="forMonth" value="<%= status.monthKey %>" required />

        <label for="paymentDate">Payment date</label>
        <%- include('../partials/date-select', { name: 'paymentDate' }) %>

        <label for="method">Method</label>
        <select id="method" name="method">
          <option value="cash">Cash</option>
          <option value="bank transfer">Bank transfer</option>
          <option value="upi">UPI</option>
          <option value="cheque">Cheque</option>
          <option value="other">Other</option>
        </select>

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="2"></textarea>

        <button type="submit" class="btn">Record payment</button>
      </form>
    </div>

    <div class="card">
      <h3>Payment history</h3>
      <% if (tenant.payments.length === 0) { %>
        <p class="muted">No payments recorded yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Month</th><th>Amount</th><th>Method</th></tr></thead>
          <tbody>
            <% tenant.payments.forEach(p => { %>
              <tr>
                <td><%= new Date(p.paymentDate).toLocaleDateString('en-IN') %></td>
                <td><%= p.forMonth %></td>
                <td><%= formatMoney(p.amount, tenant.currency) %></td>
                <td><%= p.method || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <div>
    <div class="card">
      <h3>Opening balance</h3>
      <p class="muted" style="margin-top:0;">Current: <%= formatMoney(tenant.openingBalance, tenant.currency) %></p>
      <form action="/tenants/<%= tenant.id %>/balance-adjustment" method="POST">
        <label for="newValue">New balance (<%= tenant.currency %>)</label>
        <input type="number" step="0.01" id="newValue" name="newValue" value="<%= tenant.openingBalance %>" required />

        <label for="note">Note</label>
        <input type="text" id="note" name="note" placeholder="e.g. part-payment of old dues" />

        <button type="submit" class="btn secondary">Update balance</button>
      </form>

      <% if (tenant.balanceAdjustments.length > 0) { %>
        <h3 style="margin-top:24px; font-size:14px;">History</h3>
        <table>
          <thead><tr><th>Date</th><th>Old</th><th>New</th><th>Note</th></tr></thead>
          <tbody>
            <% tenant.balanceAdjustments.forEach(a => { %>
              <tr>
                <td><%= new Date(a.createdAt).toLocaleDateString('en-IN') %></td>
                <td><%= formatMoney(a.oldValue, tenant.currency) %></td>
                <td><%= formatMoney(a.newValue, tenant.currency) %></td>
                <td class="muted"><%= a.note || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card">
      <h3>Advance</h3>
      <div class="row"><span class="k">Amount</span><span class="v"><%= formatMoney(tenant.advanceAmount, tenant.currency) %></span></div>
      <div class="row"><span class="k">Status</span><span class="v tag-violet"><%= tenant.advanceStatus %></span></div>
      <% if (tenant.advanceReturnedDate) { %>
        <div class="row"><span class="k">Returned on</span><span class="v"><%= new Date(tenant.advanceReturnedDate).toLocaleDateString('en-IN') %></span></div>
      <% } %>
    </div>

    <div class="card">
      <h3>Renew contract</h3>
      <p class="muted" style="margin-top:0;">Adding a new contract keeps the old one in history and becomes the active term.</p>
      <form action="/tenants/<%= tenant.id %>/contracts" method="POST">
        <label for="startDate">New start date</label>
        <%- include('../partials/date-select', { name: 'startDate' }) %>

        <label for="endDate">New end date</label>
        <%- include('../partials/date-select', { name: 'endDate' }) %>

        <label for="monthlyRent">New monthly rent (<%= tenant.currency %>)</label>
        <input type="number" step="0.01" id="monthlyRent" name="monthlyRent" required />

        <button type="submit" class="btn secondary">Save new contract</button>
      </form>

      <% if (tenant.contracts.length > 1) { %>
        <h3 style="margin-top:24px; font-size:14px;">Contract history</h3>
        <table>
          <thead><tr><th>Start</th><th>End</th><th>Rent</th><th>Status</th></tr></thead>
          <tbody>
            <% tenant.contracts.forEach(c => { %>
              <tr>
                <td><%= new Date(c.startDate).toLocaleDateString('en-IN') %></td>
                <td><%= new Date(c.endDate).toLocaleDateString('en-IN') %></td>
                <td><%= formatMoney(c.monthlyRent, tenant.currency) %></td>
                <td class="muted"><%= c.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <% if (tenant.status === 'active') { %>
      <div class="card">
        <h3>Vacate tenant</h3>
        <form action="/tenants/<%= tenant.id %>/vacate" method="POST" onsubmit="return confirm('Mark this tenant as vacated?');">
          <label for="advanceReturned">Was the advance returned?</label>
          <select id="advanceReturned" name="advanceReturned">
            <option value="no">Not yet</option>
            <option value="yes">Yes, returned today</option>
          </select>
          <button type="submit" class="btn danger">Mark as vacated</button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
