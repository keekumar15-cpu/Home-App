<%- include('../partials/header') %>

<div class="topbar" style="padding:0; border:none; margin-bottom:8px;">
  <h1><%= bill.name %></h1>
  <span class="badge <%= status.color %>">
    <% if (status.closed) { %>Closed
    <% } else if (status.fullyPaid) { %>Paid
    <% } else if (status.pastDue) { %>Overdue
    <% } else { %>Due
    <% } %>
  </span>
</div>
<p class="muted" style="margin-top:0;"><%= bill.category || bill.frequency %> · <%= bill.currency %></p>
<p><a href="/bills/<%= bill.id %>/edit" class="muted">Edit bill details</a> · <a href="/bills" class="muted">Back to bills</a></p>

<div class="two-col" style="margin-top:24px;">
  <div>
    <div class="card">
      <h3>Current period</h3>
      <div class="row"><span class="k">Amount</span><span class="v"><%= formatMoney(status.expected, bill.currency) %></span></div>
      <div class="row"><span class="k">Paid (<%= status.periodLabel %>)</span><span class="v"><%= formatMoney(status.paidThisPeriod, bill.currency) %></span></div>
      <div class="row"><span class="k">Outstanding</span><span class="v"><%= formatMoney(status.outstanding, bill.currency) %></span></div>
    </div>

    <div class="card">
      <h3>Log a payment</h3>
      <form action="/bills/<%= bill.id %>/payments" method="POST">
        <label for="amount">Amount (<%= bill.currency %>)</label>
        <input type="number" step="0.01" id="amount" name="amount" required />

        <% if (bill.frequency !== 'one-time') { %>
          <label for="forPeriod">For period</label>
          <input type="<%= bill.frequency === 'yearly' ? 'text' : 'month' %>" id="forPeriod" name="forPeriod" value="<%= status.monthKey %>" placeholder="<%= bill.frequency === 'yearly' ? 'e.g. 2026' : '' %>" />
        <% } %>

        <label for="paidDate">Payment date</label>
        <%- include('../partials/date-select', { name: 'paidDate' }) %>

        <label for="method">Method</label>
        <select id="method" name="method">
          <option value="cash">Cash</option>
          <option value="bank transfer">Bank transfer</option>
          <option value="upi">UPI</option>
          <option value="auto-debit">Auto-debit</option>
          <option value="other">Other</option>
        </select>

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="2"></textarea>

        <button type="submit" class="btn">Record payment</button>
      </form>
    </div>
  </div>

  <div>
    <div class="card">
      <h3>Payment history</h3>
      <% if (bill.payments.length === 0) { %>
        <p class="muted">No payments recorded yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Period</th><th>Amount</th><th>Method</th></tr></thead>
          <tbody>
            <% bill.payments.forEach(pay => { %>
              <tr>
                <td><%= new Date(pay.paidDate).toLocaleDateString('en-IN') %></td>
                <td><%= pay.forPeriod || '—' %></td>
                <td><%= formatMoney(pay.amount, bill.currency) %></td>
                <td><%= pay.method || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <% if (bill.status === 'active') { %>
      <div class="card">
        <h3>Close this bill</h3>
        <p class="muted" style="margin-top:0;">Use this once a bill no longer applies (e.g. a cancelled subscription).</p>
        <form action="/bills/<%= bill.id %>/close" method="POST" onsubmit="return confirm('Close this bill?');">
          <button type="submit" class="btn danger">Close bill</button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
