<%- include('../partials/header') %>

<h1><%= bill ? 'Edit bill' : 'Add bill' %></h1>
<p><a href="/bills" class="muted">← Back to bills</a></p>

<div class="card" style="margin-top:20px; max-width:560px;">
  <form action="<%= bill ? '/bills/' + bill.id : '/bills' %>" method="POST">
    <label for="name">Bill name</label>
    <input type="text" id="name" name="name" value="<%= bill ? bill.name : '' %>" placeholder="e.g. Electricity" required />

    <label for="category">Category</label>
    <input type="text" id="category" name="category" value="<%= bill && bill.category ? bill.category : '' %>" placeholder="e.g. Utilities" />

    <label for="currency">Currency</label>
    <select id="currency" name="currency">
      <% CURRENCY_CODES.forEach(c => { %>
        <option value="<%= c %>" <%= bill && bill.currency === c ? 'selected' : (!bill && c === 'INR' ? 'selected' : '') %>><%= c %></option>
      <% }) %>
    </select>

    <label for="amount">Amount</label>
    <input type="number" step="0.01" id="amount" name="amount" value="<%= bill ? bill.amount : '' %>" required />

    <label for="frequency">Frequency</label>
    <select id="frequency" name="frequency">
      <option value="monthly" <%= bill && bill.frequency === 'monthly' ? 'selected' : '' %>>Monthly</option>
      <option value="yearly" <%= bill && bill.frequency === 'yearly' ? 'selected' : '' %>>Yearly</option>
      <option value="one-time" <%= bill && bill.frequency === 'one-time' ? 'selected' : '' %>>One-time</option>
    </select>

    <label for="dueDay">Due day of month (for monthly/yearly)</label>
    <input type="number" min="1" max="31" id="dueDay" name="dueDay" value="<%= bill && bill.dueDay ? bill.dueDay : '' %>" />

    <label for="dueDate">Due date (for one-time)</label>
    <%- include('../partials/date-select', { name: 'dueDate', value: bill && bill.dueDate ? bill.dueDate : null }) %>

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="2"><%= bill && bill.notes ? bill.notes : '' %></textarea>

    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

    <button type="submit" class="btn"><%= bill ? 'Save changes' : 'Add bill' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
