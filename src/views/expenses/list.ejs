<%- include('../partials/header') %>

<div class="topbar" style="padding:0; border:none; margin-bottom:28px;">
  <h1>Major expenses</h1>
</div>

<% Object.keys(totalsByCurrency).forEach(cur => { const totals = totalsByCurrency[cur]; %>
  <div class="currency-group-label"><%= cur %></div>
  <div class="metrics">
    <div class="metric expected">
      <div class="label">This month</div>
      <div class="value"><%= formatMoney(totals.thisMonth, cur) %></div>
    </div>
    <div class="metric received">
      <div class="label">This year</div>
      <div class="value"><%= formatMoney(totals.thisYear, cur) %></div>
    </div>
    <div class="metric outstanding">
      <div class="label">All time</div>
      <div class="value"><%= formatMoney(totals.allTime, cur) %></div>
    </div>
  </div>
<% }) %>

<div class="two-col">
  <div>
    <div class="card">
      <h3>Log an expense</h3>
      <form action="/expenses" method="POST">
        <label for="date">Date</label>
        <%- include('../partials/date-select', { name: 'date' }) %>

        <label for="description">Description</label>
        <input type="text" id="description" name="description" placeholder="e.g. New laptop for MSAII" required />

        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. Equipment, Travel, Medical" />

        <label for="currency">Currency</label>
        <select id="currency" name="currency">
          <% CURRENCY_CODES.forEach(c => { %>
            <option value="<%= c %>" <%= c === 'INR' ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>

        <label for="amount">Amount</label>
        <input type="number" step="0.01" id="amount" name="amount" required />

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="2"></textarea>

        <button type="submit" class="btn">Add expense</button>
      </form>
    </div>
  </div>

  <div>
    <div class="card">
      <h3>History</h3>
      <% if (expenses.length === 0) { %>
        <p class="muted">No expenses logged yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th><th></th></tr></thead>
          <tbody>
            <% expenses.forEach(e => { %>
              <tr>
                <td><%= new Date(e.date).toLocaleDateString('en-IN') %></td>
                <td><%= e.description %></td>
                <td class="muted"><%= e.category || '—' %></td>
                <td><%= formatMoney(e.amount, e.currency) %></td>
                <td>
                  <a href="/expenses/<%= e.id %>/edit" class="muted">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
