<%- include('../partials/header') %>

<h1><%= loan ? 'Edit loan' : 'Add loan' %></h1>
<p><a href="/loans" class="muted">← Back to loans</a></p>

<div class="card" style="margin-top:20px; max-width:560px;">
  <form action="<%= loan ? '/loans/' + loan.id : '/loans' %>" method="POST">
    <label for="borrowerName">Borrower name</label>
    <input type="text" id="borrowerName" name="borrowerName" value="<%= loan ? loan.borrowerName : '' %>" required />

    <label for="contact">Contact</label>
    <input type="text" id="contact" name="contact" value="<%= loan && loan.contact ? loan.contact : '' %>" />

    <label for="currency">Currency</label>
    <select id="currency" name="currency">
      <% CURRENCY_CODES.forEach(c => { %>
        <option value="<%= c %>" <%= loan && loan.currency === c ? 'selected' : (!loan && c === 'INR' ? 'selected' : '') %>><%= c %></option>
      <% }) %>
    </select>

    <label for="principal">Principal amount</label>
    <input type="number" step="0.01" id="principal" name="principal" value="<%= loan ? loan.principal : '' %>" required />

    <label for="dateGiven">Date given</label>
    <%- include('../partials/date-select', { name: 'dateGiven', value: loan && loan.dateGiven ? loan.dateGiven : null }) %>

    <label for="interestRate">Interest rate (%, 0 if interest-free)</label>
    <input type="number" step="0.01" id="interestRate" name="interestRate" value="<%= loan ? loan.interestRate : '0' %>" />

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="2"><%= loan && loan.notes ? loan.notes : '' %></textarea>

    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

    <button type="submit" class="btn"><%= loan ? 'Save changes' : 'Add loan' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
